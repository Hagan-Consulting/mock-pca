#
# OpenSSL `ca` configuration shared by every mock CA. bin/mockpca runs
# openssl with the CA's own directory as the working directory, so `dir` is
# relative. Extensions come from the per-issuance file (issue.cnf, built from
# the *.ext profiles); nothing is copied from CSRs.
[ ca ]
default_ca = mockpca_ca

[ mockpca_ca ]
dir               = .
database          = $dir/index.txt
new_certs_dir     = $dir/newcerts
certificate       = $dir/ca.pem
private_key       = $dir/ca.key
crlnumber         = $dir/crlnumber
# Random positive serial numbers of at most 20 octets (CP Table 13).
rand_serial       = yes
default_md        = sha256
default_crl_hours = 24
policy            = mockpca_policy
copy_extensions   = none
# End-Entity subject DNs repeat during rollover (CP 3.1.1); bin/mockpca
# enforces uniqueness itself and allows repeats only for --renew.
unique_subject    = no
# Subject attribute order: bin/mockpca passes -preserveDN, which keeps the
# order of -subj (the CP table order). OpenSSL 3.0 ignores "preserve = yes"
# here and would reorder the DN by the policy section.
email_in_dn       = no
# CP 3.1.1: PrintableString, or UTF8String when the value cannot be encoded
# as PrintableString (B_ASN1_PRINTABLESTRING | B_ASN1_UTF8STRING).
string_mask       = MASK:0x2002
utf8              = yes
crl_extensions    = mockpca_crl_ext

[ mockpca_policy ]
countryName            = optional
stateOrProvinceName    = optional
localityName           = optional
organizationName       = supplied
organizationalUnitName = optional
commonName             = supplied

# CP Table 39: v2 CRL with authorityKeyIdentifier and cRLNumber (added by
# openssl because `crlnumber` is set). No critical CRL extensions (7.2.2).
[ mockpca_crl_ext ]
authorityKeyIdentifier = keyid:always
