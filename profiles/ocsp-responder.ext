#
# Delegated OCSP responder (CSS) Certificate, one per CA, issued by that CA:
# CP 7.3 (signed by the issuing CA, id-pkix-ocsp-nocheck), RFC 6960 4.2.2.2
# (extKeyUsage id-kp-OCSPSigning), RFC 5280 4.2.1.3 (keyUsage digitalSignature
# for signatures other than on certificates and CRLs), Table 7 CSS row
# (RSA >= 2048), 4.10 (a CSS asserts the policy OIDs it is authoritative for),
# subjectAltName per 7.1.2.11. No AIA/CDP (RFC 5019 2.2.2 recommends neither):
# nocheck tells relying parties not to check the responder's revocation status. See docs/CP-NOTES.md N21.
[ mockpca_ext ]
authorityKeyIdentifier = keyid:always
certificatePolicies    = 1.3.6.1.4.1.55670.1
extendedKeyUsage       = critical, OCSPSigning
keyUsage               = critical, digitalSignature
noCheck                = ignored
subjectAltName         = @mockpca_san
subjectKeyIdentifier   = hash
