#!/usr/bin/env bash
# Copyright 2026 Hagan Consulting Inc.
# SPDX-License-Identifier: Apache-2.0
#
# mockpca: development-only mock of the NG9-1-1 PCA PKI (CP v1.3).
#
# Creates a mock PCA root, ICAs and End-Entity certificates with OpenSSL,
# checks every certificate with mockpca-lint, revokes certificates and
# publishes CRLs. Run `mockpca help` for usage. NOT FOR PRODUCTION.
set -euo pipefail
umask 077

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILES="$ROOT/profiles"
CA_CNF="$PROFILES/ca.cnf"
OPENSSL="${OPENSSL:-openssl}"
PKI="${MOCKPCA_PKI:-$PWD/pki}"
POLICY_OID="1.3.6.1.4.1.55670.1"
QUAD_OID="1.3.6.1.4.1.55670.1.1"
# Ignore any system-wide OpenSSL configuration.
export OPENSSL_CONF=/dev/null

# Paths removed when the script exits (temporary files, failed issuances).
CLEANUP=()
cleanup() { ((${#CLEANUP[@]} == 0)) || rm -rf -- "${CLEANUP[@]}"; }
# cleanup_drop PATH: keep PATH after all (it was completed).
cleanup_drop() {
	local keep=() p
	for p in "${CLEANUP[@]}"; do [[ $p == "$1" ]] || keep+=("$p"); done
	CLEANUP=("${keep[@]}")
}
trap cleanup EXIT

usage() {
	cat <<'EOF'
mockpca: development-only mock of the NG9-1-1 PCA PKI (CP v1.3). NOT FOR PRODUCTION.

usage: mockpca [--pki DIR] COMMAND [options]

The PKI directory defaults to $MOCKPCA_PKI, else ./pki.

Commands:
  init      Create the PKI directory and the mock PCA root.
              --base-url URL   base of the CRL/CA certificate/OCSP URLs baked into certificates (required),
                               e.g. http://pca.mock.test:8080
              --id FQDN        PCA iD for the Quad ID (required)
              [--org ORG] [--country CC] [--cn CN] [--ou-serial N] [--days N]
  ica       Create an ICA under the PCA or another ICA.
              --name NAME --parent CA --id FQDN --owner AGENCY_ID --org ORG --label LABEL
              [--pathlen N] [--country CC] [--st ST] [--l L] [--ou-serial N] [--days N]
              CN becomes "<LABEL> ICA Tier<n>". Subject DN and Quad ID must be unique in the PKI.
            ica --name NAME --renew OLD [--days N] [--ou-serial N]
              Re-keys ICA OLD: new key and OU serial number; Quad ID, parent, O, C, ST, L, label and
              pathLenConstraint are kept (options that differ from OLD are refused).
  issue     Generate a key pair and issue an End-Entity certificate.
              --ca CA --profile agency|agent|element|service|signing --name NAME --id ID --roles R1[,R2...]
              --org ORG [--owner AGENCY_ID] [--dns NAME]... [--ip ADDR]... [--ou OU] [--st ST] [--l L]
              [--country CC] [--days N] [--key rsa:BITS|ec:CURVE] [--id-type TYPE] [--renew NAME]
              Subject DN and Quad ID must be unique in the PKI; --renew NAME re-keys or renews
              certificate NAME (same subject DN and Quad ID).
  sign-csr  Like issue, for an externally generated key: --csr FILE instead of --key.
  revoke    Revoke a certificate and republish its issuer's CRL.
              --ee NAME | --ca NAME   [--reason REASON]
  crl       Regenerate and publish CRLs.   --ca NAME | --all   [--hours N | --seconds N]
              Lifetimes over 24 hours are allowed for testing but exceed CP Table 3 (warning).
  verify    Verify a certificate with OpenSSL (chain, CP policy OID, CRLs).   --ee NAME | --ca NAME  [--no-crl]
  list      List CAs and End-Entity certificates with their status.
  lint      Run mockpca-lint on certificate files.   [mockpca-lint flags] FILE...
  ocsp-signer   Choose or renew a CA's OCSP signer.   --ca NAME [--mode delegated|ca] [--rotate] [--days N]
              delegated (default): the CA's responder certificate in ca/NAME/ocsp/ (issued with the CA);
              ca: the CA key signs its own responses. --rotate issues a new responder certificate.
  ocsp-fault    Fault injection for a CA's OCSP responder (read by mockpca-serve on every request).
              --ca NAME  --clear | --show | [--http-status N] [--delay-ms N]
              [--status unauthorized|malformedRequest|tryLater|internalError] [--sha1-only] [--stale]
              [--wrong-signer | --no-nocheck] [--unknown]      (each call replaces the CA's faults)
              --no-nocheck signs with a NEGATIVE FIXTURE: a responder certificate issued by the CA
              without id-pkix-ocsp-nocheck (made on demand in ca/NAME/ocsp/negative-no-nocheck/).
  ocsp-response Write a fresh DER OCSP response for a certificate (stapling tests).
              --ee NAME [--out FILE] [--nmin N]   (default ee/NAME/ocsp.der, nextUpdate 60 minutes)
  serve     Serve CA certificates, CRLs and OCSP over HTTP; refresh CRLs and responder certificates.
              [--listen ADDR] [--crl-hours N] [--ocsp-nmin N]
  help      Show this help.

See README.md and docs/ for details.
EOF
}

die() {
	echo "mockpca: $*" >&2
	exit 1
}

note() { echo "mockpca: $*" >&2; }

# ---------------------------------------------------------------------------
# Input validation. Every value that ends up in an OpenSSL config file or
# command line is checked here first.

LABEL_RE='[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?'
FQDN_RE="^(${LABEL_RE}\\.)+${LABEL_RE}\$"
DNS_RE="^(${LABEL_RE}\\.)*${LABEL_RE}\$"

valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]; }
valid_fqdn() { [[ ${#1} -le 253 && $1 =~ $FQDN_RE ]]; }
valid_agent_id() {
	local user="${1%%@*}" host="${1#*@}"
	if [[ $1 != *@* ]]; then
		valid_fqdn "$1"
	else
		[[ $user =~ ^[A-Za-z0-9._-]{1,64}$ ]] && valid_fqdn "$host"
	fi
}
valid_roles() { [[ $1 =~ ^[A-Za-z0-9:._-]+(,[A-Za-z0-9:._-]+)*$ ]]; }
valid_country() { [[ $1 =~ ^[A-Z]{2}$ ]]; }
valid_int() { [[ $1 =~ ^[0-9]{1,9}$ ]]; }

check_name() { valid_name "$2" || die "$1: '$2' is not a valid name (lower-case letters, digits, '-')"; }
check_int() { valid_int "$2" || die "$1: '$2' is not a non-negative integer"; }

# DN attribute values: no control characters or characters that are special
# in OpenSSL config files; at most 64 characters (RFC 5280 upper bounds).
check_dn() {
	local opt="$1" v="$2"
	[[ -n $v ]] || die "$opt must not be empty"
	[[ $v =~ [[:cntrl:]] || $v == *'#'* || $v == *'$'* || $v == *'\'* || $v == *'"'* ]] &&
		die "$opt: control characters, '#', '\$', '\\' and '\"' are not allowed"
	[[ $v == " "* || $v == *" " ]] && die "$opt: leading or trailing space"
	((${#v} <= 64)) || die "$opt: longer than 64 characters"
}

check_base_url() {
	[[ $1 =~ ^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~-]+)*$ ]] ||
		die "--base-url: '$1' must be http(s)://host[:port][/path] without a trailing slash, query or comma"
}

# ---------------------------------------------------------------------------
# Small key=value state files (never sourced).

kv_get() {
	local file="$1" key="$2" k v
	[[ -f $file ]] || die "missing $file"
	while IFS='=' read -r k v; do
		if [[ $k == "$key" ]]; then
			printf '%s' "$v"
			return 0
		fi
	done <"$file"
	return 1
}

kv_set() {
	local file="$1" key="$2" value="$3" tmp
	[[ $value != *$'\n'* ]] || die "internal: newline in value for $key"
	tmp="$file.tmp"
	{
		if [[ -f $file ]]; then grep -v "^$key=" "$file" || true; fi
		printf '%s=%s\n' "$key" "$value"
	} >"$tmp"
	mv "$tmp" "$file"
}

# ---------------------------------------------------------------------------
# Helpers.

require_openssl() {
	local v
	v="$("$OPENSSL" version 2>/dev/null)" || die "'$OPENSSL' not found; install OpenSSL 3.x (set \$OPENSSL to its path)"
	[[ $v =~ ^OpenSSL\ ([3-9]|[1-9][0-9])\. ]] || die "need OpenSSL 3.x or later, found: $v (LibreSSL is not supported)"
}

require_pki() { [[ -f $PKI/pki.conf ]] || die "no PKI at $PKI (run 'mockpca init' or pass --pki)"; }

base_url() { kv_get "$PKI/pki.conf" base_url; }

ca_dir() {
	local d="$PKI/ca/$1"
	[[ -f $d/ca.conf ]] || die "no CA named '$1'"
	printf '%s' "$d"
}

# require_active_ca NAME: refuse to issue from a CA that is revoked or has a
# revoked ancestor.
require_active_ca() {
	local name="$1" d parent
	while :; do
		d="$(ca_dir "$name")"
		parent="$(kv_get "$d/ca.conf" parent || true)"
		[[ -n $parent ]] || return 0
		if [[ $(status_of "$d/ca.pem" "$parent") == R ]]; then
			[[ $name == "$1" ]] && die "CA '$1' is revoked"
			die "CA '$1' cannot issue: its issuer '$name' is revoked"
		fi
		name="$parent"
	done
}

ee_dir() {
	local d="$PKI/ee/$1"
	[[ -f $d/ee.conf ]] || die "no End-Entity certificate named '$1'"
	printf '%s' "$d"
}

# Tools are built from this checkout on first use (go build caches).
go_tool() {
	local name="$1" exe
	command -v go >/dev/null 2>&1 || die "Go is required to build $name (see README)"
	exe="$ROOT/.build/$name$(go env GOEXE)"
	(cd "$ROOT" && go build -o "$exe" "./cmd/$name") || die "building $name failed"
	printf '%s' "$exe"
}

# resolve_lint builds mockpca-lint before anything is signed, so a build
# failure cannot leave an unchecked certificate behind.
LINT=""
resolve_lint() { [[ -n $LINT ]] || LINT="${MOCKPCA_LINT:-$(go_tool mockpca-lint)}"; }

run_lint() {
	local profile="$1" cert="$2" issuer="${3:-}" args
	args=(-q -profile "$profile")
	resolve_lint
	[[ -z $issuer ]] || args+=(-issuer "$issuer")
	[[ ! -f $PKI/trust/pca.pem ]] || args+=(-root "$PKI/trust/pca.pem")
	"$LINT" "${args[@]}" "$cert"
}

# reject_issued CERT ISSUER DIR: after a failed lint, revoke the certificate
# in its issuer's database, republish the issuer's CRL and move DIR to
# $PKI/rejected/, so that nothing usable or valid is left behind.
reject_issued() {
	local cert="$1" issuer="$2" dir="$3" dest
	(cd "$(ca_dir "$issuer")" && "$OPENSSL" ca -config "$CA_CNF" -revoke "$cert" -crl_reason superseded 2>/dev/null) ||
		note "could not revoke the rejected certificate $cert"
	gen_crl "$issuer"
	dest="$PKI/rejected/$(basename "$dir")-$(serial_of "$cert")"
	mkdir -p "$PKI/rejected"
	mv "$dir" "$dest"
	die "the certificate does not conform to the CP profile (see above); it was revoked and moved to $dest"
}

# check_unique SUBJECT QUAD COMMAND [RENEWAL]: subject DNs and Quad IDs are
# unique in the PKI (CP 3.1.5, 7.1.2.11). Certificates moved to rejected/ do
# not count. A renewal or re-key (RENEWAL non-empty) keeps the Quad ID of the
# certificate it renews, so only the subject DN is checked: ICA re-keys get a
# new OU serial number (3.1.5), End-Entity renewals skip the check entirely.
check_unique() {
	local subj="$1" quad="$2" cmd="$3" renewal="${4:-}" conf
	for conf in "$PKI"/ca/*/ca.conf "$PKI"/ee/*/ee.conf; do
		[[ -f $conf ]] || continue
		[[ $(kv_get "$conf" subject || true) != "$subj" ]] ||
			die "subject DN $subj is already used by $(dirname "$conf") (CP 3.1.5)"
		[[ -n $renewal || $(kv_get "$conf" quad || true) != "$quad" ]] ||
			die "Quad ID $quad is already used by $(dirname "$conf") (CP 7.1.2.11); for a renewal or re-key use '$cmd --renew NAME'"
	done
}

# check_csr_key PROFILE CSR: CP 6.1.6, the RA only uses CSRs whose key meets
# the key size of the requested certificate (Table 7) and FIPS 186-4.
check_csr_key() {
	local profile="$1" csr="$2" info bits e
	info="$("$OPENSSL" req -in "$csr" -noout -pubkey | "$OPENSSL" pkey -pubin -noout -text)" ||
		die "--csr: cannot read the public key"
	if [[ $profile == signing ]]; then
		[[ $info == *"ED25519 Public-Key"* || $info =~ NIST\ CURVE:\ P-(256|384|521) ]] ||
			die "--csr: a Signing Certificate needs an ECC P-256/P-384/P-521 or Ed25519 key (CP Table 7)"
		return
	fi
	[[ $info =~ Public-Key:\ \(([0-9]+)\ bit\) && $info == *Modulus:* ]] ||
		die "--csr: $profile certificates need an RSA key (CP Table 7)"
	bits="${BASH_REMATCH[1]}"
	((bits >= 2048)) || die "--csr: RSA key of $bits bits, at least 2048 required (CP Table 7)"
	[[ $info =~ Exponent:\ ([0-9]+)\  ]] || die "--csr: unsupported RSA public exponent"
	e="${BASH_REMATCH[1]}"
	((${#e} <= 18 && e > 65536 && e % 2 == 1)) ||
		die "--csr: RSA public exponent $e is not allowed (FIPS 186-4: odd, greater than 65536)"
}

# Escape a value for an `openssl -subj` argument.
subj_escape() {
	local v="${1//\//\\/}"
	printf '%s' "${v//+/\\+}"
}

# notAfter of a certificate as YYYYMMDDHHMMSSZ.
not_after() {
	local d
	d="$("$OPENSSL" x509 -in "$1" -noout -enddate -dateopt iso_8601)"
	d="${d#notAfter=}"
	d="${d//[^0-9]/}"
	printf '%sZ' "$d"
}

# validity_args ISSUER_CERT DAYS: prints openssl ca validity options, capped
# at the issuer's notAfter (CP 6.3.2: validity periods are nested).
validity_args() {
	local issuer="$1" days="$2"
	if "$OPENSSL" x509 -in "$issuer" -noout -checkend $((days * 86400)) >/dev/null; then
		printf -- '-days\n%s\n' "$days"
	else
		note "validity capped at the issuer's notAfter ($(not_after "$issuer"))"
		printf -- '-enddate\n%s\n' "$(not_after "$issuer")"
	fi
}

genkey() {
	local spec="$1" out="$2"
	case "$spec" in
	rsa:2048 | rsa:3072 | rsa:4096)
		"$OPENSSL" genpkey -algorithm RSA -pkeyopt "rsa_keygen_bits:${spec#rsa:}" -out "$out" 2>/dev/null
		;;
	ec:P-256 | ec:P-384 | ec:P-521)
		"$OPENSSL" genpkey -algorithm EC -pkeyopt "ec_paramgen_curve:${spec#ec:}" -out "$out"
		;;
	*) die "--key: '$spec' is not one of rsa:2048, rsa:3072, rsa:4096, ec:P-256, ec:P-384, ec:P-521" ;;
	esac
}

# write_issue_cnf FILE PROFILE QUAD DNS_LIST IP_LIST VARS...
# Writes the per-issuance OpenSSL config: URL/pathlen variables, the request
# section, the profile's extension section and the subjectAltName section.
write_issue_cnf() {
	local file="$1" profile="$2" quad="$3" dns="$4" ips="$5" i=0 v
	shift 5
	{
		echo "# Generated by mockpca on $(date -u +%Y-%m-%dT%H:%M:%SZ). Profile: $profile."
		for v in "$@"; do echo "$v"; done
		cat <<-EOF

			[ req ]
			distinguished_name = mockpca_dn
			prompt             = no
			utf8               = yes
			string_mask        = MASK:0x2002

			# The subject is set with -subj when the certificate is signed.
			[ mockpca_dn ]
			O = mockpca request

		EOF
		cat "$PROFILES/$profile.ext"
		echo
		echo "[ mockpca_san ]"
		echo "otherName.0 = $QUAD_OID;UTF8:$quad"
		for v in $dns; do
			echo "DNS.$i = $v"
			i=$((i + 1))
		done
		i=0
		for v in $ips; do
			echo "IP.$i = $v"
			i=$((i + 1))
		done
	} >"$file"
}

publish_ca_cert() {
	local name="$1" d
	d="$(ca_dir "$name")"
	"$OPENSSL" x509 -in "$d/ca.pem" -outform DER -out "$PKI/www/certs/$name.cer.tmp"
	mv "$PKI/www/certs/$name.cer.tmp" "$PKI/www/certs/$name.cer"
}

# gen_crl NAME [crl-period-option value]
gen_crl() {
	local name="$1" d period=("${@:2}")
	d="$(ca_dir "$name")"
	[[ ${#period[@]} -gt 0 ]] || period=(-crlhours "$(kv_get "$PKI/pki.conf" crl_hours)")
	(cd "$d" && "$OPENSSL" ca -config "$CA_CNF" -gencrl "${period[@]}" -out crl.pem.tmp 2>/dev/null) ||
		die "CRL generation for '$name' failed"
	mv "$d/crl.pem.tmp" "$d/crl.pem"
	"$OPENSSL" crl -in "$d/crl.pem" -outform DER -out "$PKI/www/crl/$name.crl.tmp"
	mv "$PKI/www/crl/$name.crl.tmp" "$PKI/www/crl/$name.crl"
}

# chain_of CA: the CA certificate followed by its issuers, excluding the PCA.
chain_of() {
	local name="$1" d parent
	while [[ -n $name ]]; do
		d="$(ca_dir "$name")"
		[[ $(kv_get "$d/ca.conf" profile) == pca ]] && break
		cat "$d/ca.pem"
		parent="$(kv_get "$d/ca.conf" parent)"
		name="$parent"
	done
}

serial_of() {
	local s
	s="$("$OPENSSL" x509 -in "$1" -noout -serial)"
	printf '%s' "${s#serial=}"
}

# status_of CERT CA_NAME: V (valid), R (revoked) or E (expired) from the
# issuer's database.
status_of() {
	local serial d st
	serial="$(serial_of "$1")"
	d="$(ca_dir "$2")"
	# Tab-separated: status, expiry, revocation date (often empty), serial, ...
	st="$(awk -F'\t' -v s="${serial^^}" 'toupper($4) == s { print $1 }' "$d/index.txt")"
	if [[ $st == V ]] && ! "$OPENSSL" x509 -in "$1" -noout -checkend 0 >/dev/null; then
		st=E
	fi
	printf '%s' "${st:-?}"
}

# ---------------------------------------------------------------------------
# Commands.

cmd_init() {
	local base_url="" id="" org="MOCK NG911 PCA - NOT FOR PRODUCTION" country="US" cn="PCA Root" ou_serial=1 days=3650
	while (($#)); do
		case "$1" in
		--base-url) base_url="${2:?}"; shift 2 ;;
		--id) id="${2:?}"; shift 2 ;;
		--org) org="${2:?}"; shift 2 ;;
		--country) country="${2:?}"; shift 2 ;;
		--cn) cn="${2:?}"; shift 2 ;;
		--ou-serial) ou_serial="${2:?}"; shift 2 ;;
		--days) days="${2:?}"; shift 2 ;;
		*) die "init: unknown option $1" ;;
		esac
	done
	[[ -n $base_url ]] || die "init: --base-url is required"
	[[ -n $id ]] || die "init: --id is required"
	base_url="${base_url%/}"
	check_base_url "$base_url"
	valid_fqdn "$id" || die "--id: '$id' is not a lower-case FQDN"
	check_dn --org "$org"
	check_dn --cn "$cn"
	valid_country "$country" || die "--country: two upper-case letters (ISO 3166-1)"
	check_int --ou-serial "$ou_serial"
	check_int --days "$days"
	((days <= 3652)) || die "--days: the PCA certificate is valid for at most 10 years (CP Table 12)"
	if [[ -e $PKI ]]; then
		[[ -d $PKI && -z $(ls -A "$PKI") ]] || die "$PKI exists and is not an empty directory"
		CLEANUP+=("$PKI/pki.conf" "$PKI/ca" "$PKI/ee" "$PKI/trust" "$PKI/www")
	else
		CLEANUP+=("$PKI")
	fi
	resolve_lint

	mkdir -p "$PKI"/{ca,ee,trust,www/certs,www/crl}
	kv_set "$PKI/pki.conf" base_url "$base_url"
	kv_set "$PKI/pki.conf" country "$country"
	kv_set "$PKI/pki.conf" crl_hours 24
	kv_set "$PKI/pki.conf" next_ica_serial 1

	local name=pca d="$PKI/ca/pca"
	mkdir -p "$d/newcerts"
	: >"$d/index.txt"
	echo 01 >"$d/crlnumber"
	note "generating the PCA key (RSA 4096)"
	genkey rsa:4096 "$d/ca.key"
	write_issue_cnf "$d/issue.cnf" pca "cAId/$id/PCA/$id" "" ""
	"$OPENSSL" req -new -config "$d/issue.cnf" -key "$d/ca.key" -out "$d/ca.csr"
	local subj="/C=$country/O=$(subj_escape "$org")/OU=PCA-$ou_serial/CN=$(subj_escape "$cn")"
	(cd "$d" && "$OPENSSL" ca -batch -config "$CA_CNF" -preserveDN -selfsign -keyfile ca.key -in ca.csr -out ca.pem \
		-extfile issue.cnf -extensions mockpca_ext -days "$days" -notext -subj "$subj" 2>/dev/null) ||
		die "issuing the PCA certificate failed"
	# A failing PCA certificate removes the whole new PKI (cleanup on exit).
	run_lint pca "$d/ca.pem" || die "the PCA certificate does not conform to the CP profile (see above)"
	kv_set "$d/ca.conf" profile pca
	kv_set "$d/ca.conf" tier 1
	kv_set "$d/ca.conf" id "$id"
	kv_set "$d/ca.conf" subject "$subj"
	kv_set "$d/ca.conf" quad "cAId/$id/PCA/$id"
	kv_set "$d/ca.conf" owner "$id"
	kv_set "$d/ca.conf" org "$org"
	kv_set "$d/ca.conf" country "$country"
	cp "$d/ca.pem" "$PKI/trust/pca.pem"
	publish_ca_cert "$name"
	gen_crl "$name"
	issue_responder "$name"
	CLEANUP=()
	note "PCA created: $d/ca.pem (trust anchor: $PKI/trust/pca.pem)"
}

cmd_ica() {
	local name="" parent="" id="" owner="" org="" label="" pathlen="" country="" st="" l="" ou_serial="" days=1095
	local renew="" given=()
	while (($#)); do
		case "$1" in
		--parent | --id | --owner | --org | --label | --pathlen | --country | --st | --l) given+=("${1#--}") ;;&
		--renew) renew="${2:?}"; shift 2 ;;
		--name) name="${2:?}"; shift 2 ;;
		--parent) parent="${2:?}"; shift 2 ;;
		--id) id="${2:?}"; shift 2 ;;
		--owner) owner="${2:?}"; shift 2 ;;
		--org) org="${2:?}"; shift 2 ;;
		--label) label="${2:?}"; shift 2 ;;
		--pathlen) pathlen="${2:?}"; shift 2 ;;
		--country) country="${2:?}"; shift 2 ;;
		--st) st="${2:?}"; shift 2 ;;
		--l) l="${2:?}"; shift 2 ;;
		--ou-serial) ou_serial="${2:?}"; shift 2 ;;
		--days) days="${2:?}"; shift 2 ;;
		*) die "ica: unknown option $1" ;;
		esac
	done
	require_pki
	if [[ -n $renew ]]; then
		ica_renewal_values
	fi
	for v in name parent id owner org label; do
		[[ -n ${!v} ]] || die "ica: --$v is required"
	done
	check_name --name "$name"
	check_name --parent "$parent"
	valid_fqdn "$id" || die "--id: '$id' is not a lower-case FQDN"
	valid_fqdn "$owner" || die "--owner: '$owner' is not a lower-case FQDN"
	check_dn --org "$org"
	check_dn --label "$label"
	[[ -z $st ]] || check_dn --st "$st"
	[[ -z $l ]] || check_dn --l "$l"
	country="${country:-$(kv_get "$PKI/pki.conf" country)}"
	valid_country "$country" || die "--country: two upper-case letters (ISO 3166-1)"
	check_int --days "$days"
	((days <= 1095)) || die "--days: an ICA certificate is valid for at most 3 years (CP Table 12)"
	[[ ! -e $PKI/ca/$name ]] || die "a CA named '$name' already exists"

	local pd ptier pprofile ppathlen tier
	pd="$(ca_dir "$parent")"
	require_active_ca "$parent"
	ptier="$(kv_get "$pd/ca.conf" tier)"
	pprofile="$(kv_get "$pd/ca.conf" profile)"
	tier=$((ptier + 1))
	if [[ $pprofile == pca ]]; then
		pathlen="${pathlen:-1}"
		[[ $pathlen =~ ^[0-3]$ ]] || die "--pathlen: a Tier-2 ICA takes 0-3 (CP Table 22)"
	else
		ppathlen="$(kv_get "$pd/ca.conf" pathlen)"
		((ppathlen > 0)) || die "CA '$parent' has pathLenConstraint 0 and cannot issue ICAs"
		[[ -z $pathlen || $pathlen == $((ppathlen - 1)) ]] ||
			die "--pathlen: a Tier-$tier ICA takes its issuer's pathLenConstraint minus one ($((ppathlen - 1)), CP Table 23)"
		pathlen=$((ppathlen - 1))
	fi
	local auto_serial=""
	if [[ -z $ou_serial ]]; then
		# Next serial number not used by an existing ICA's OU; the counter is
		# only advanced once the ICA has been issued.
		ou_serial="$(kv_get "$PKI/pki.conf" next_ica_serial)"
		while cat "$PKI"/ca/*/ca.conf 2>/dev/null | grep -q "^subject=.*/OU=ICA-$ou_serial/"; do
			ou_serial=$((ou_serial + 1))
		done
		auto_serial=1
	fi
	check_int --ou-serial "$ou_serial"
	local cn="$label ICA Tier$tier"
	check_dn "CN ($cn)" "$cn"
	# Subject attribute order of CP Table 2: c, o, ou, [st], [l], cn.
	local subj="/C=$country/O=$(subj_escape "$org")/OU=ICA-$ou_serial"
	[[ -z $st ]] || subj+="/ST=$(subj_escape "$st")"
	[[ -z $l ]] || subj+="/L=$(subj_escape "$l")"
	subj+="/CN=$(subj_escape "$cn")"
	local quad="cAId/$id/ICA/$owner"
	check_unique "$subj" "$quad" ica "$renew"
	resolve_lint

	local d="$PKI/ca/$name" base
	base="$(base_url)"
	CLEANUP+=("$d")
	mkdir -p "$d/newcerts"
	: >"$d/index.txt"
	echo 01 >"$d/crlnumber"
	note "generating the key of ICA '$name' (RSA 3072)"
	genkey rsa:3072 "$d/ca.key"
	write_issue_cnf "$d/issue.cnf" ica "$quad" "" "" \
		"MOCKPCA_OCSP_URL = $base/ocsp/$parent" \
		"MOCKPCA_CRL_URL = $base/crl/$parent.crl" \
		"MOCKPCA_PATHLEN = $pathlen"
	"$OPENSSL" req -new -config "$d/issue.cnf" -key "$d/ca.key" -out "$d/ca.csr"
	local validity
	mapfile -t validity < <(validity_args "$pd/ca.pem" "$days")
	(cd "$pd" && "$OPENSSL" ca -batch -config "$CA_CNF" -preserveDN -in "$d/ca.csr" -out "$d/ca.pem" \
		-extfile "$d/issue.cnf" -extensions mockpca_ext "${validity[@]}" -notext -subj "$subj" 2>/dev/null) ||
		die "issuing the ICA certificate failed"
	CLEANUP=()
	# The CA state (ca.conf) is only written once the certificate passed.
	run_lint ica "$d/ca.pem" "$pd/ca.pem" || reject_issued "$d/ca.pem" "$parent" "$d"
	kv_set "$d/ca.conf" profile ica
	kv_set "$d/ca.conf" parent "$parent"
	kv_set "$d/ca.conf" tier "$tier"
	kv_set "$d/ca.conf" pathlen "$pathlen"
	kv_set "$d/ca.conf" id "$id"
	kv_set "$d/ca.conf" subject "$subj"
	kv_set "$d/ca.conf" quad "$quad"
	# Kept by a re-key (ica --renew).
	kv_set "$d/ca.conf" owner "$owner"
	kv_set "$d/ca.conf" org "$org"
	kv_set "$d/ca.conf" label "$label"
	kv_set "$d/ca.conf" country "$country"
	kv_set "$d/ca.conf" st "$st"
	kv_set "$d/ca.conf" l "$l"
	[[ -z $renew ]] || kv_set "$d/ca.conf" renews "$renew"
	[[ -z $auto_serial ]] || kv_set "$PKI/pki.conf" next_ica_serial $((ou_serial + 1))
	chain_of "$name" >"$d/chain.pem"
	publish_ca_cert "$name"
	gen_crl "$name"
	note "ICA '$name' (Tier $tier, pathLenConstraint $pathlen) created: $d/ca.pem${renew:+ (re-key of '$renew')}"
	issue_responder "$name"
}

# ---------------------------------------------------------------------------
# OCSP (served by mockpca-serve, signed by OpenSSL).

# issue_responder CA [DAYS]: issue the CA's delegated OCSP responder
# certificate into ca/<CA>/ocsp/ (CP 7.3, N21), replacing (and revoking as
# superseded) an existing one.
issue_responder() {
	local name="$1" days="${2:-30}" d od id owner org country rid subj quad nd validity
	d="$(ca_dir "$name")"
	od="$d/ocsp"
	id="$(kv_get "$d/ca.conf" id)"
	owner="$(kv_get "$d/ca.conf" owner || printf '%s' "$id")"
	org="$(kv_get "$d/ca.conf" org)" || die "CA '$name' was created by an older mockpca (no org in ca.conf)"
	country="$(kv_get "$d/ca.conf" country || kv_get "$PKI/pki.conf" country)"
	rid="ocsp.$id"
	((${#rid} <= 64)) || die "responder iD $rid is longer than 64 characters"
	# Subject attribute order of CP Tables 2 and 36: c, o, cn.
	subj="/C=$country/O=$(subj_escape "$org")/CN=$rid"
	quad="elementId/$rid/OCSPResponder/$owner"
	resolve_lint
	nd="$od/responder"
	mkdir -p "$od"
	rm -rf "$nd"
	mkdir "$nd"
	CLEANUP+=("$nd")
	genkey rsa:2048 "$nd/key.pem"
	write_issue_cnf "$nd/issue.cnf" ocsp-responder "$quad" "" ""
	"$OPENSSL" req -new -config "$nd/issue.cnf" -key "$nd/key.pem" -out "$nd/csr.pem"
	mapfile -t validity < <(validity_args "$d/ca.pem" "$days")
	(cd "$d" && "$OPENSSL" ca -batch -config "$CA_CNF" -preserveDN -in "$nd/csr.pem" -out "$nd/cert.pem" \
		-extfile "$nd/issue.cnf" -extensions mockpca_ext "${validity[@]}" -notext -subj "$subj" 2>/dev/null) ||
		die "issuing the OCSP responder certificate of '$name' failed"
	cleanup_drop "$nd"
	run_lint ocsp-responder "$nd/cert.pem" "$d/ca.pem" || reject_issued "$nd/cert.pem" "$name" "$nd"
	if [[ -f $od/cert.pem && $(status_of "$od/cert.pem" "$name") != R ]]; then
		(cd "$d" && "$OPENSSL" ca -config "$CA_CNF" -revoke "$od/cert.pem" -crl_reason superseded 2>/dev/null) ||
			note "could not revoke the previous responder certificate of '$name'"
		gen_crl "$name"
	fi
	local f
	for f in key.pem csr.pem issue.cnf cert.pem; do mv "$nd/$f" "$od/$f"; done
	rmdir "$nd"
	note "OCSP responder certificate of '$name': $od/cert.pem (iD $rid)"
}

# ocsp_signer_files CA_DIR: prints the signing certificate and key of a CA's
# responder (ocsp.conf: delegated or ca).
ocsp_signer_files() {
	local d="$1" mode
	mode="$(kv_get "$d/ocsp.conf" signer 2>/dev/null || true)"
	case "${mode:-delegated}" in
	delegated) printf '%s\n%s\n' "$d/ocsp/cert.pem" "$d/ocsp/key.pem" ;;
	ca) printf '%s\n%s\n' "$d/ca.pem" "$d/ca.key" ;;
	*) die "$d/ocsp.conf: unknown signer '$mode'" ;;
	esac
}

cmd_ocsp_signer() {
	local ca="" mode="" rotate=0 days=30
	while (($#)); do
		case "$1" in
		--ca) ca="${2:?}"; shift 2 ;;
		--mode) mode="${2:?}"; shift 2 ;;
		--rotate) rotate=1; shift ;;
		--days) days="${2:?}"; shift 2 ;;
		*) die "ocsp-signer: unknown option $1" ;;
		esac
	done
	require_pki
	[[ -n $ca ]] || die "ocsp-signer: --ca is required"
	check_name --ca "$ca"
	[[ -n $mode || $rotate == 1 ]] || die "ocsp-signer: give --mode and/or --rotate"
	check_int --days "$days"
	((days >= 1 && days <= 365)) || die "--days: 1 to 365"
	local d
	d="$(ca_dir "$ca")"
	if [[ -n $mode ]]; then
		[[ $mode == delegated || $mode == ca ]] || die "--mode: delegated or ca"
		kv_set "$d/ocsp.conf" signer "$mode"
		note "OCSP responses of '$ca' are signed by $([[ $mode == ca ]] && echo "the CA key" || echo "its responder certificate")"
	fi
	if ((rotate)); then
		resolve_lint
		issue_responder "$ca" "$days"
	fi
}

cmd_ocsp_fault() {
	local ca="" clear=0 show=0 lines=() rogue=0 nonocheck=0
	while (($#)); do
		case "$1" in
		--ca) ca="${2:?}"; shift 2 ;;
		--clear) clear=1; shift ;;
		--show) show=1; shift ;;
		--http-status)
			[[ ${2:?} =~ ^[1-5][0-9][0-9]$ ]] || die "--http-status: 100-599"
			lines+=("http_status=$2"); shift 2 ;;
		--delay-ms)
			check_int --delay-ms "${2:?}"
			((10#$2 <= 25000)) || die "--delay-ms: at most 25000 (below the server's write timeout)"
			lines+=("delay_ms=$((10#$2))"); shift 2 ;;
		--status)
			[[ ${2:?} =~ ^(unauthorized|malformedRequest|tryLater|internalError)$ ]] ||
				die "--status: unauthorized, malformedRequest, tryLater or internalError"
			lines+=("status=$2"); shift 2 ;;
		--sha1-only) lines+=("sha1_only=1"); shift ;;
		--stale) lines+=("stale=1"); shift ;;
		--wrong-signer) lines+=("wrong_signer=1"); rogue=1; shift ;;
		--no-nocheck) lines+=("no_nocheck=1"); nonocheck=1; shift ;;
		--unknown) lines+=("unknown=1"); shift ;;
		*) die "ocsp-fault: unknown option $1" ;;
		esac
	done
	require_pki
	[[ -n $ca ]] || die "ocsp-fault: --ca is required"
	check_name --ca "$ca"
	local d f
	d="$(ca_dir "$ca")"
	f="$d/ocsp-fault.conf"
	if ((show)); then
		if [[ -s $f ]]; then cat "$f"; else echo "no faults"; fi
		return
	fi
	if ((clear)); then
		[[ ${#lines[@]} -eq 0 ]] || die "ocsp-fault: --clear takes no other faults"
		rm -f "$f"
		note "OCSP faults of '$ca' cleared"
		return
	fi
	[[ ${#lines[@]} -gt 0 ]] || die "ocsp-fault: give faults, --clear or --show"
	((rogue + nonocheck < 2)) || die "ocsp-fault: --wrong-signer and --no-nocheck each choose the signer; give one"
	if ((rogue)); then
		make_rogue_signer "$d/ocsp"
	fi
	if ((nonocheck)); then
		make_no_nocheck_signer "$ca"
	fi
	printf '%s\n' "${lines[@]}" >"$f.tmp"
	mv "$f.tmp" "$f"
	note "OCSP faults of '$ca': ${lines[*]}"
}

# make_rogue_signer DIR: a self-signed OCSP signing certificate outside the
# PKI, for the wrong-signer fault. Deliberately untrusted and named as such
# (CLAUDE.md: negative fixtures are explicit); mockpca-lint rejects it.
make_rogue_signer() {
	local od="$1"
	[[ ! -f $od/rogue-cert.pem ]] || return 0
	mkdir -p "$od"
	cat >"$od/rogue.cnf" <<-'EOF'
		[ req ]
		distinguished_name = rogue_dn
		[ rogue_dn ]
		[ rogue_ext ]
		keyUsage         = critical, digitalSignature
		extendedKeyUsage = OCSPSigning
	EOF
	genkey rsa:2048 "$od/rogue-key.pem"
	"$OPENSSL" req -x509 -new -key "$od/rogue-key.pem" -config "$od/rogue.cnf" -extensions rogue_ext -days 30 \
		-subj "/O=MOCK ROGUE OCSP SIGNER - NOT TRUSTED/CN=rogue.ocsp.mock.test" -out "$od/rogue-cert.pem" ||
		die "creating the rogue OCSP signer failed"
}

# make_no_nocheck_signer CA: the NEGATIVE TEST FIXTURE of the no-nocheck
# fault: an OCSP responder certificate issued by the CA itself but without
# id-pkix-ocsp-nocheck (profiles/negative-ocsp-responder-no-nocheck.ext), in
# ca/<CA>/ocsp/negative-no-nocheck/. Made only on demand (and again when it
# expires within a day), kept apart from the CA's real responder and outside
# the uniqueness check, and it must still be reported by mockpca-lint
# (CLAUDE.md): if the lint passes it, or reports anything but the missing
# nocheck, the fixture is wrong and the command fails.
make_no_nocheck_signer() {
	local name="$1" d nd id owner org country rid subj quad validity out
	d="$(ca_dir "$name")"
	nd="$d/ocsp/negative-no-nocheck"
	if [[ -f $nd/cert.pem ]] && "$OPENSSL" x509 -in "$nd/cert.pem" -noout -checkend 86400 >/dev/null; then
		return 0
	fi
	require_active_ca "$name"
	id="$(kv_get "$d/ca.conf" id)"
	owner="$(kv_get "$d/ca.conf" owner || printf '%s' "$id")"
	org="$(kv_get "$d/ca.conf" org)" || die "CA '$name' was created by an older mockpca (no org in ca.conf)"
	country="$(kv_get "$d/ca.conf" country || kv_get "$PKI/pki.conf" country)"
	rid="negative-no-nocheck.ocsp.$id"
	((${#rid} <= 64)) || die "fixture iD $rid is longer than 64 characters"
	subj="/C=$country/O=$(subj_escape "$org")/CN=$rid"
	quad="elementId/$rid/OCSPResponder/$owner"
	resolve_lint
	rm -rf "$nd"
	mkdir -p "$nd"
	CLEANUP+=("$nd")
	genkey rsa:2048 "$nd/key.pem"
	write_issue_cnf "$nd/issue.cnf" negative-ocsp-responder-no-nocheck "$quad" "" ""
	"$OPENSSL" req -new -config "$nd/issue.cnf" -key "$nd/key.pem" -out "$nd/csr.pem"
	mapfile -t validity < <(validity_args "$d/ca.pem" 30)
	(cd "$d" && "$OPENSSL" ca -batch -config "$CA_CNF" -preserveDN -in "$nd/csr.pem" -out "$nd/cert.pem" \
		-extfile "$nd/issue.cnf" -extensions mockpca_ext "${validity[@]}" -notext -subj "$subj" 2>/dev/null) ||
		die "issuing the no-nocheck fixture of '$name' failed"
	cleanup_drop "$nd"
	# A fixture with any other lint result is wrong: like any certificate
	# that fails its check, it is revoked and moved to rejected/.
	if out="$("$LINT" -q -profile ocsp-responder -issuer "$d/ca.pem" -root "$PKI/trust/pca.pem" "$nd/cert.pem")"; then
		note "negative fixture $nd/cert.pem passed mockpca-lint, but must lack id-pkix-ocsp-nocheck"
		reject_issued "$nd/cert.pem" "$name" "$nd"
	fi
	if [[ $out != *"id-pkix-ocsp-nocheck is missing"* || $(grep -c ERROR <<<"$out") != 1 ]]; then
		note "negative fixture $nd/cert.pem: unexpected lint findings: $out"
		reject_issued "$nd/cert.pem" "$name" "$nd"
	fi
	note "NEGATIVE FIXTURE (mockpca-lint reports it, as expected): $nd/cert.pem: ${out#*: }"
}

cmd_ocsp_response() {
	local ee="" out="" nmin=60
	while (($#)); do
		case "$1" in
		--ee) ee="${2:?}"; shift 2 ;;
		--out) out="${2:?}"; shift 2 ;;
		--nmin) nmin="${2:?}"; shift 2 ;;
		*) die "ocsp-response: unknown option $1" ;;
		esac
	done
	require_pki
	[[ -n $ee ]] || die "ocsp-response: --ee is required"
	check_name --ee "$ee"
	check_int --nmin "$nmin"
	((nmin >= 1)) || die "--nmin: at least 1"
	local d ca cadir tmp signer
	d="$(ee_dir "$ee")"
	ca="$(kv_get "$d/ee.conf" ca)"
	cadir="$(ca_dir "$ca")"
	out="${out:-$d/ocsp.der}"
	tmp="$(mktemp -d "$PKI/.ocsp.XXXXXX")"
	CLEANUP+=("$tmp")
	mapfile -t signer < <(ocsp_signer_files "$cadir")
	[[ ${#signer[@]} -eq 2 ]] || die "cannot determine the OCSP signer of '$ca'"
	"$OPENSSL" ocsp -issuer "$cadir/ca.pem" -sha256 -cert "$d/cert.pem" -no_nonce -reqout "$tmp/req.der" >/dev/null ||
		die "building the OCSP request failed"
	"$OPENSSL" ocsp -index "$cadir/index.txt" -CA "$cadir/ca.pem" -rsigner "${signer[0]}" -rkey "${signer[1]}" \
		-rmd sha256 -nmin "$nmin" -reqin "$tmp/req.der" -respout "$tmp/resp.der" >/dev/null 2>&1 ||
		die "signing the OCSP response failed"
	mv "$tmp/resp.der" "$out"
	note "OCSP response for '$ee' written to $out (nextUpdate in $nmin minutes)"
}

# refresh_responders: renew delegated responder certificates that expire
# within 7 days (or are missing), for CAs that are not revoked.
refresh_responders() {
	local d name parent
	for d in "$PKI"/ca/*/; do
		name="$(basename "$d")"
		[[ -f $d/ca.conf ]] || continue
		parent="$(kv_get "$d/ca.conf" parent || true)"
		[[ -z $parent || $(status_of "$d/ca.pem" "$parent") == V ]] || continue
		if [[ ! -f $d/ocsp/cert.pem ]] || ! "$OPENSSL" x509 -in "$d/ocsp/cert.pem" -noout -checkend 604800 >/dev/null; then
			# A separate process, so that errexit stays in force inside it.
			"${BASH_SOURCE[0]}" --pki "$PKI" ocsp-signer --ca "$name" --rotate ||
				note "renewing the OCSP responder certificate of '$name' failed"
		fi
	done
}

# ica_renewal_values: for ica --renew, take the Quad ID, parent and subject
# values of the ICA being re-keyed (cmd_ica's variables) and refuse options
# that differ from them (CP 3.1.5: a re-key keeps the names; the new OU serial
# number keeps the subject DN unique).
ica_renewal_values() {
	local rd v old
	check_name --renew "$renew"
	rd="$(ca_dir "$renew")"
	[[ $(kv_get "$rd/ca.conf" profile) == ica ]] || die "--renew: '$renew' is not an ICA"
	kv_get "$rd/ca.conf" label >/dev/null || die "--renew: '$renew' was created by an older mockpca without re-key data"
	for v in parent id owner org label country st l pathlen; do
		old="$(kv_get "$rd/ca.conf" "$v" || true)"
		if [[ " ${given[*]} " == *" $v "* && ${!v} != "$old" ]]; then
			die "--$v: a re-key keeps the $v of ICA '$renew' (${old:-none})"
		fi
		printf -v "$v" '%s' "$old"
	done
}

# issue and sign-csr share the option parsing and the signing step.
cmd_issue() {
	local mode="$1"
	shift
	local ca="" profile="" name="" id="" roles="" owner="" org="" ou="" st="" l="" country="" days=90
	local key_spec="" csr="" id_type="" renew="" dns=() ips=()
	while (($#)); do
		case "$1" in
		--ca) ca="${2:?}"; shift 2 ;;
		--profile) profile="${2:?}"; shift 2 ;;
		--name) name="${2:?}"; shift 2 ;;
		--id) id="${2:?}"; shift 2 ;;
		--roles) roles="${2:?}"; shift 2 ;;
		--owner) owner="${2:?}"; shift 2 ;;
		--org) org="${2:?}"; shift 2 ;;
		--ou) ou="${2:?}"; shift 2 ;;
		--st) st="${2:?}"; shift 2 ;;
		--l) l="${2:?}"; shift 2 ;;
		--country) country="${2:?}"; shift 2 ;;
		--days) days="${2:?}"; shift 2 ;;
		--dns) dns+=("${2:?}"); shift 2 ;;
		--ip) ips+=("${2:?}"); shift 2 ;;
		--id-type) id_type="${2:?}"; shift 2 ;;
		--renew) renew="${2:?}"; shift 2 ;;
		--key)
			[[ $mode == issue ]] || die "sign-csr: --key is not used (the key is in the CSR)"
			key_spec="${2:?}"; shift 2 ;;
		--csr)
			[[ $mode == sign-csr ]] || die "issue: --csr is only for sign-csr"
			csr="${2:?}"; shift 2 ;;
		*) die "$mode: unknown option $1" ;;
		esac
	done
	require_pki
	for v in ca profile name id roles org; do
		[[ -n ${!v} ]] || die "$mode: --$v is required"
	done
	[[ $mode == issue || -n $csr ]] || die "sign-csr: --csr is required"
	check_name --ca "$ca"
	check_name --name "$name"
	[[ -z $renew ]] || check_name --renew "$renew"
	[[ ! -e $PKI/ee/$name ]] || die "an End-Entity certificate named '$name' already exists"
	[[ $(kv_get "$(ca_dir "$ca")/ca.conf" profile) != pca ]] ||
		die "the PCA issues ICA certificates only; End-Entity certificates come from an ICA (CP 1.4.1)"

	local default_type
	case "$profile" in
	agency) default_type=agencyId ;;
	agent) default_type=agentId ;;
	element) default_type=elementId ;;
	service) default_type=serviceId ;;
	signing) default_type=elementId ;;
	*) die "--profile: one of agency, agent, element, service, signing" ;;
	esac
	if [[ -n $id_type && $profile != signing ]]; then
		die "--id-type is only for the signing profile ($profile uses $default_type)"
	fi
	id_type="${id_type:-$default_type}"
	[[ $id_type =~ ^(agencyId|agentId|elementId|serviceId)$ ]] || die "--id-type: agencyId, agentId, elementId or serviceId"

	if [[ $profile == agent ]]; then
		valid_agent_id "$id" || die "--id: '$id' is not user@fqdn or a lower-case FQDN"
	else
		valid_fqdn "$id" || die "--id: '$id' is not a lower-case FQDN"
	fi
	((${#id} <= 64)) || die "--id: the iD is also the subject CN, which holds at most 64 characters (RFC 5280)"
	valid_roles "$roles" || die "--roles: comma-separated, no spaces; letters, digits, ':', '.', '_', '-'"
	if [[ $profile == agency ]]; then
		# Table 28: the Agency's own iD; a NIOC Agency Certificate has the PCA's iD.
		local pca_id
		pca_id="$(kv_get "$(ca_dir pca)/ca.conf" id)"
		[[ -z $owner || $owner == "$id" || $owner == "$pca_id" ]] ||
			die "--owner: an Agency Certificate's owner is its own iD, or the PCA's iD ($pca_id) for a NIOC Agency Certificate (CP Table 28)"
		owner="${owner:-$id}"
	fi
	[[ -n $owner ]] || die "$mode: --owner (iD of the controlling Agency) is required"
	valid_fqdn "$owner" || die "--owner: '$owner' is not a lower-case FQDN"
	check_dn --org "$org"
	[[ -z $ou ]] || check_dn --ou "$ou"
	[[ -z $st ]] || check_dn --st "$st"
	[[ -z $l ]] || check_dn --l "$l"
	country="${country:-$(kv_get "$PKI/pki.conf" country)}"
	valid_country "$country" || die "--country: two upper-case letters (ISO 3166-1)"
	check_int --days "$days"
	((days <= 1095)) || die "--days: at most 3 years (CP Table 12)"

	# The first dNSName is the iD (CP Table 30); Agency, Element and Service
	# Certificates must have one, for Agent and Signing Certificates they are
	# optional, but if present the iD still comes first.
	local all_dns=() x
	case "$profile" in
	agency | element | service) all_dns=("$id") ;;
	agent | signing)
		if ((${#dns[@]})); then
			valid_fqdn "$id" ||
				die "--dns: the first DNS name must be the iD (CP Table 30), and '$id' is not a DNS name"
			all_dns=("$id")
		fi
		;;
	esac
	for x in "${dns[@]}"; do
		[[ $x =~ $DNS_RE && ${#x} -le 253 ]] || die "--dns: '$x' is not a lower-case DNS name (no wildcards)"
		[[ $x == "$id" ]] || all_dns+=("$x")
	done
	for x in "${ips[@]}"; do
		[[ $x =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ || $x =~ ^[0-9A-Fa-f:]+$ ]] || die "--ip: '$x' is not an IP address"
	done

	# Subject attribute order of CP Tables 2 and 36: c, o, [l], [st], [ou], cn.
	local subj="/C=$country/O=$(subj_escape "$org")"
	[[ -z $l ]] || subj+="/L=$(subj_escape "$l")"
	[[ -z $st ]] || subj+="/ST=$(subj_escape "$st")"
	[[ -z $ou ]] || subj+="/OU=$(subj_escape "$ou")"
	subj+="/CN=$(subj_escape "$id")"
	local quad="$id_type/$id/$roles/$owner"
	if [[ -n $renew ]]; then
		local rconf
		rconf="$(ee_dir "$renew")/ee.conf"
		[[ $(kv_get "$rconf" subject || true) == "$subj" && $(kv_get "$rconf" quad || true) == "$quad" ]] ||
			die "--renew: a renewal or re-key keeps the subject DN and Quad ID of '$renew'"
	else
		check_unique "$subj" "$quad" issue
	fi
	[[ $mode == issue ]] || check_csr_key "$profile" "$csr"

	local cadir d base
	cadir="$(ca_dir "$ca")"
	require_active_ca "$ca"
	resolve_lint
	d="$PKI/ee/$name"
	base="$(base_url)"
	mkdir -p "$d"
	CLEANUP+=("$d")
	write_issue_cnf "$d/issue.cnf" "$profile" "$quad" "${all_dns[*]:-}" "${ips[*]:-}" \
		"MOCKPCA_CA_CERT_URL = $base/certs/$ca.cer" \
		"MOCKPCA_OCSP_URL = $base/ocsp/$ca" \
		"MOCKPCA_CRL_URL = $base/crl/$ca.crl"
	if [[ $mode == issue ]]; then
		if [[ -z $key_spec ]]; then
			key_spec=rsa:2048
			[[ $profile != signing ]] || key_spec=ec:P-256
		fi
		genkey "$key_spec" "$d/key.pem"
		"$OPENSSL" req -new -config "$d/issue.cnf" -key "$d/key.pem" -out "$d/csr.pem"
	else
		"$OPENSSL" req -in "$csr" -noout -verify 2>/dev/null || die "--csr: '$csr' is not a CSR with a valid signature"
		"$OPENSSL" req -in "$csr" -out "$d/csr.pem"
	fi
	local validity
	mapfile -t validity < <(validity_args "$cadir/ca.pem" "$days")
	(cd "$cadir" && "$OPENSSL" ca -batch -config "$CA_CNF" -preserveDN -in "$d/csr.pem" -out "$d/cert.pem" \
		-extfile "$d/issue.cnf" -extensions mockpca_ext "${validity[@]}" -notext -subj "$subj" 2>/dev/null) ||
		die "issuing the certificate failed (is the CA's key valid and the CSR's key large enough?)"
	CLEANUP=()
	run_lint "$profile" "$d/cert.pem" "$cadir/ca.pem" || reject_issued "$d/cert.pem" "$ca" "$d"
	kv_set "$d/ee.conf" profile "$profile"
	kv_set "$d/ee.conf" ca "$ca"
	kv_set "$d/ee.conf" id "$id"
	kv_set "$d/ee.conf" subject "$subj"
	kv_set "$d/ee.conf" quad "$quad"
	[[ -z $renew ]] || kv_set "$d/ee.conf" renews "$renew"
	chain_of "$ca" >"$d/chain.pem"
	cat "$d/cert.pem" "$d/chain.pem" >"$d/fullchain.pem"
	note "issued $profile certificate '$name': $d/cert.pem (chain: fullchain.pem, key: ${key_spec:+key.pem}${csr:+external})"
}

cmd_revoke() {
	local ee="" ca="" reason=unspecified
	while (($#)); do
		case "$1" in
		--ee) ee="${2:?}"; shift 2 ;;
		--ca) ca="${2:?}"; shift 2 ;;
		--reason) reason="${2:?}"; shift 2 ;;
		*) die "revoke: unknown option $1" ;;
		esac
	done
	require_pki
	[[ (-n $ee && -z $ca) || (-z $ee && -n $ca) ]] || die "revoke: give exactly one of --ee or --ca"
	# No certificateHold: suspension is not supported by the CP (4.9.13).
	[[ $reason =~ ^(unspecified|keyCompromise|CACompromise|affiliationChanged|superseded|cessationOfOperation)$ ]] ||
		die "--reason: unspecified, keyCompromise, CACompromise, affiliationChanged, superseded or cessationOfOperation"
	local cert issuer
	if [[ -n $ee ]]; then
		check_name --ee "$ee"
		cert="$(ee_dir "$ee")/cert.pem"
		issuer="$(kv_get "$(ee_dir "$ee")/ee.conf" ca)"
	else
		check_name --ca "$ca"
		[[ $(kv_get "$(ca_dir "$ca")/ca.conf" profile) != pca ]] || die "the PCA root cannot be revoked (remove it from trust bundles instead)"
		cert="$(ca_dir "$ca")/ca.pem"
		issuer="$(kv_get "$(ca_dir "$ca")/ca.conf" parent)"
	fi
	[[ $(status_of "$cert" "$issuer") != R ]] || die "already revoked"
	(cd "$(ca_dir "$issuer")" && "$OPENSSL" ca -config "$CA_CNF" -revoke "$cert" -crl_reason "$reason" 2>/dev/null) ||
		die "revocation failed"
	gen_crl "$issuer"
	note "revoked ${ee:-$ca} ($reason); CRL of '$issuer' republished"
}

cmd_crl() {
	local ca="" all=0 period=()
	while (($#)); do
		case "$1" in
		--ca) ca="${2:?}"; shift 2 ;;
		--all) all=1; shift ;;
		--hours)
			check_int --hours "${2:?}"
			((10#$2 <= 24)) || note "WARNING: a CRL lifetime of $2 hours exceeds CP Table 3 (a new CRL at least every 24 hours); allowed for testing"
			period=(-crlhours "$2"); shift 2 ;;
		--seconds)
			check_int --seconds "${2:?}"
			((10#$2 <= 86400)) || note "WARNING: a CRL lifetime of $2 seconds exceeds CP Table 3 (a new CRL at least every 24 hours); allowed for testing"
			period=(-crlsec "$2"); shift 2 ;;
		*) die "crl: unknown option $1" ;;
		esac
	done
	require_pki
	[[ (-n $ca && $all == 0) || (-z $ca && $all == 1) ]] || die "crl: give --ca NAME or --all"
	local names=()
	if ((all)); then
		for d in "$PKI"/ca/*/; do names+=("$(basename "$d")"); done
	else
		check_name --ca "$ca"
		names=("$ca")
	fi
	for n in "${names[@]}"; do
		gen_crl "$n" "${period[@]}"
		note "CRL of '$n' published: $PKI/www/crl/$n.crl"
	done
}

cmd_verify() {
	local ee="" ca="" crl=1
	while (($#)); do
		case "$1" in
		--ee) ee="${2:?}"; shift 2 ;;
		--ca) ca="${2:?}"; shift 2 ;;
		--no-crl) crl=0; shift ;;
		*) die "verify: unknown option $1" ;;
		esac
	done
	require_pki
	[[ (-n $ee && -z $ca) || (-z $ee && -n $ca) ]] || die "verify: give exactly one of --ee or --ca"
	local cert issuer
	if [[ -n $ee ]]; then
		check_name --ee "$ee"
		cert="$(ee_dir "$ee")/cert.pem"
		issuer="$(kv_get "$(ee_dir "$ee")/ee.conf" ca)"
	else
		check_name --ca "$ca"
		cert="$(ca_dir "$ca")/ca.pem"
		issuer="$(kv_get "$(ca_dir "$ca")/ca.conf" parent || true)"
	fi
	local tmp args=(-x509_strict -CAfile "$PKI/trust/pca.pem")
	tmp="$(mktemp -d "$PKI/.verify.XXXXXX")"
	CLEANUP+=("$tmp")
	: >"$tmp/chain.pem"
	[[ -z $issuer ]] || chain_of "$issuer" >"$tmp/chain.pem"
	[[ ! -s $tmp/chain.pem ]] || args+=(-untrusted "$tmp/chain.pem")
	# The PCA certificate itself asserts no policy (CP Table 14).
	[[ $cert == "$PKI/trust/pca.pem" || -z $issuer ]] ||
		args+=(-policy_check -explicit_policy -policy "$POLICY_OID")
	if ((crl)); then
		cat "$PKI"/ca/*/crl.pem >"$tmp/crls.pem"
		args+=(-crl_check_all -CRLfile "$tmp/crls.pem")
	fi
	"$OPENSSL" verify "${args[@]}" "$cert"
}

cmd_list() {
	require_pki
	local d name
	printf '%-16s %-8s %-5s %-16s %-6s %s\n' NAME PROFILE TIER ISSUER STATUS "NOT AFTER"
	for d in "$PKI"/ca/*/; do
		name="$(basename "$d")"
		[[ -f $d/ca.pem ]] || continue
		local parent st=V
		parent="$(kv_get "$d/ca.conf" parent || true)"
		[[ -z $parent ]] || st="$(status_of "$d/ca.pem" "$parent")"
		printf '%-16s %-8s %-5s %-16s %-6s %s\n' "$name" "$(kv_get "$d/ca.conf" profile)" \
			"$(kv_get "$d/ca.conf" tier)" "${parent:--}" "$st" "$(not_after "$d/ca.pem")"
	done
	for d in "$PKI"/ee/*/; do
		[[ -f $d/cert.pem ]] || continue
		name="$(basename "$d")"
		local ca
		ca="$(kv_get "$d/ee.conf" ca)"
		printf '%-16s %-8s %-5s %-16s %-6s %s\n' "$name" "$(kv_get "$d/ee.conf" profile)" "-" "$ca" \
			"$(status_of "$d/cert.pem" "$ca")" "$(not_after "$d/cert.pem")"
	done
}

cmd_serve() {
	local listen="127.0.0.1:8080" hours nmin=60
	require_pki
	hours="$(kv_get "$PKI/pki.conf" crl_hours)"
	while (($#)); do
		case "$1" in
		--listen) listen="${2:?}"; shift 2 ;;
		--crl-hours) check_int --crl-hours "${2:?}"; hours="$2"; shift 2 ;;
		--ocsp-nmin) check_int --ocsp-nmin "${2:?}"; nmin="$2"; shift 2 ;;
		*) die "serve: unknown option $1" ;;
		esac
	done
	((hours > 0)) || die "--crl-hours must be at least 1"
	((hours <= 48)) ||
		note "WARNING: republishing CRLs every $((hours / 2)) hours exceeds CP Table 3 (a new CRL at least every 24 hours); allowed for testing"
	kv_set "$PKI/pki.conf" crl_hours "$hours"
	local serve pid sleeper=""
	((nmin >= 1)) || die "--ocsp-nmin must be at least 1"
	serve="$(go_tool mockpca-serve)"
	resolve_lint
	refresh_responders
	cmd_crl --all
	"$serve" -pki "$PKI" -listen "$listen" -openssl "$(command -v "$OPENSSL")" -nmin "$nmin" &
	pid=$!
	trap 'kill "$pid" $sleeper 2>/dev/null; wait "$pid" 2>/dev/null; exit 0' INT TERM
	note "serving $PKI/www and OCSP on $listen; CRLs are republished every $((hours * 30)) minutes (half their lifetime)"
	# CRLs are republished every half lifetime; responder certificates (30
	# days, renewed within 7 days of expiry) are checked daily, whatever the
	# CRL interval. Sleep until whichever is due first.
	local crl_every=$((hours * 1800)) next_crl next_check
	next_crl=$((SECONDS + crl_every))
	next_check=$((SECONDS + SERVE_CHECK_EVERY))
	while kill -0 "$pid" 2>/dev/null; do
		sleep "$(serve_wait "$SECONDS" "$next_crl" "$next_check")" </dev/null >/dev/null 2>&1 &
		sleeper=$!
		wait "$sleeper" || true
		sleeper=""
		kill -0 "$pid" 2>/dev/null || break
		if ((SECONDS >= next_check)); then
			refresh_responders
			next_check=$((SECONDS + SERVE_CHECK_EVERY))
		fi
		if ((SECONDS >= next_crl)); then
			cmd_crl --all
			next_crl=$((SECONDS + crl_every))
		fi
	done
	wait "$pid"
}

# Seconds between responder certificate checks in serve.
SERVE_CHECK_EVERY=86400

# serve_wait NOW NEXT_CRL NEXT_CHECK: the seconds serve sleeps until the
# earlier of the next CRL republishing and the next responder check (at
# least 1, so an overdue task does not spin).
serve_wait() {
	local next=$(($2 < $3 ? $2 : $3))
	echo $((next > $1 ? next - $1 : 1))
}

main() {
	if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
		die "bash 4.4 or later is required (macOS: install bash from a package manager)"
	fi
	while (($#)); do
		case "$1" in
		--pki) PKI="${2:?}"; shift 2 ;;
		-h | --help | help) usage; exit 0 ;;
		-*) die "unknown option $1 (see 'mockpca help')" ;;
		*) break ;;
		esac
	done
	(($#)) || { usage >&2; exit 2; }
	local cmd="$1"
	shift
	case "$cmd" in
	lint) exec "${MOCKPCA_LINT:-$(go_tool mockpca-lint)}" "$@" ;;
	esac
	require_openssl
	case "$cmd" in
	init) cmd_init "$@" ;;
	ica) cmd_ica "$@" ;;
	issue) cmd_issue issue "$@" ;;
	sign-csr) cmd_issue sign-csr "$@" ;;
	revoke) cmd_revoke "$@" ;;
	crl) cmd_crl "$@" ;;
	verify) cmd_verify "$@" ;;
	list) cmd_list "$@" ;;
	serve) cmd_serve "$@" ;;
	ocsp-signer) cmd_ocsp_signer "$@" ;;
	ocsp-fault) cmd_ocsp_fault "$@" ;;
	ocsp-response) cmd_ocsp_response "$@" ;;
	*) die "unknown command '$cmd' (see 'mockpca help')" ;;
	esac
}

# Run main unless sourced (scripts/test-mockpca.sh tests single functions).
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
